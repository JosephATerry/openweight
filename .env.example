# Safe local-development values. Copy this file to .env before using Compose.
POSTGRES_DB=openweight_platform
POSTGRES_USER=openweight
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_SSLROOTCERT=

TAVILY_API_KEY=

# API defaults are loopback-only. Build metadata is injected by packaging.
OPENWEIGHT_ENVIRONMENT=development
OPENWEIGHT_SERVICE_VERSION=0.1.0
OPENWEIGHT_BUILD_SHA=
OPENWEIGHT_LOG_LEVEL=INFO
OPENWEIGHT_API_HOST=127.0.0.1
OPENWEIGHT_API_PORT=8000
OPENWEIGHT_DEPLOYMENT_PROFILE=local

# Runtime capability configuration. PostgreSQL is required by default for
# policy retrieval, operational lookups, and the approval-gated write.
OPENWEIGHT_BACKEND=gpt-oss
OPENWEIGHT_MAX_NEW_TOKENS=768
OPENWEIGHT_DATABASE_REQUIRED=true
OPENWEIGHT_DATABASE_PROBE_TIMEOUT_SECONDS=2
OPENWEIGHT_CHECKPOINT_BACKEND=memory
OPENWEIGHT_WEB_ENABLED=false

# Backend-specific optional overrides.
OPENWEIGHT_GPT_OSS_MODEL_ID=openai/gpt-oss-20b
OPENWEIGHT_MUSE_BASE_URL=http://127.0.0.1:8080/v1
OPENWEIGHT_MUSE_MODEL_ALIAS=meta-models/Muse-Glimmer-30B
OPENWEIGHT_MUSE_TIMEOUT_SECONDS=300
OPENWEIGHT_REASONING_STRENGTH=low

# Hugging Face recruiter-demo settings are inert under the default local
# profile. HF_TOKEN is a runtime secret and must never be put in Git or VITE_*.
HF_TOKEN=
OPENWEIGHT_HF_PROVIDER=groq
OPENWEIGHT_HF_TIMEOUT_SECONDS=60
OPENWEIGHT_HF_MAX_RETRIES=0
OPENWEIGHT_HF_INFERENCE_CONCURRENCY_LIMIT=2
OPENWEIGHT_HF_RATE_LIMIT_REQUESTS=5
OPENWEIGHT_HF_RATE_LIMIT_WINDOW_SECONDS=60
OPENWEIGHT_HF_RATE_LIMIT_MAX_CLIENTS=1024
OPENWEIGHT_HF_PUBLIC_ORIGIN=
OPENWEIGHT_DEMO_POLICY_INDEX=deploy/huggingface/policy_index.npz
OPENWEIGHT_DEMO_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Privacy-safe local observability. Logs use stdout JSON; metrics are local at
# /metrics. Tracing is disabled unless an OTLP endpoint is explicitly supplied.
OPENWEIGHT_OBSERVABILITY_ENABLED=true
OPENWEIGHT_METRICS_ENABLED=true
OPENWEIGHT_METRICS_ACCESS_MODE=public
OPENWEIGHT_TRACING_ENABLED=false
OPENWEIGHT_OBSERVABILITY_SERVICE_NAME=openweight-platform
OPENWEIGHT_OTLP_ENDPOINT=

# Standards-based product authentication is optional for local development.
# Cloud deployments enable it and supply tenant-specific HTTPS metadata; no
# bearer token, signing key, or client secret belongs in this file.
OPENWEIGHT_AUTH_ENABLED=false
OPENWEIGHT_AUTH_ISSUER=
OPENWEIGHT_AUTH_AUDIENCE=
OPENWEIGHT_AUTH_JWKS_URL=

# MCP is an optional Streamable HTTP surface mounted in the API process.
# Authenticated deployments must set the public, credential-free MCP URL.
OPENWEIGHT_MCP_ENABLED=false
OPENWEIGHT_MCP_PATH=/mcp
OPENWEIGHT_MCP_SERVER_NAME=openweight-platform
OPENWEIGHT_MCP_RESOURCE_SERVER_URL=
OPENWEIGHT_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
OPENWEIGHT_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# The production container serves the compiled React application. Native API
# development keeps this off and uses the Vite proxy. These are paths/flags,
# never credentials. VITE_* values are public browser configuration.
OPENWEIGHT_FRONTEND_ENABLED=false
OPENWEIGHT_FRONTEND_DIST_DIR=frontend/dist
VITE_DEMO_MODE=true

# Restrict LangGraph checkpoint deserialization to explicitly allowed types.
LANGGRAPH_STRICT_MSGPACK=true
